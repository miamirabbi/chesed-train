.p-6.w-full
  %h1.text-2xl.font-bold.mb-4 Feedback & Issues

  .mb-4.space-x-2
    = link_to 'All', admin_feedbacks_path, class: "px-3 py-1 rounded-lg border #{'bg-primary-original text-white' unless params[:category].present?}"
    = link_to 'Issues', admin_feedbacks_path(category: 'issue'), class: "px-3 py-1 rounded-lg border #{'bg-primary-original text-white' if params[:category] == 'issue'}"
    = link_to 'Feedback', admin_feedbacks_path(category: 'feedback'), class: "px-3 py-1 rounded-lg border #{'bg-primary-original text-white' if params[:category] == 'feedback'}"

  - if @feedbacks.empty?
    %p.text-secondary No submissions yet.
  - else
    %table.w-full.border-collapse
      %thead
        %tr.bg-gray-100
          %th.p-2.text-left.border Date
          %th.p-2.text-left.border Type
          %th.p-2.text-left.border Name
          %th.p-2.text-left.border Email
          %th.p-2.text-left.border Message
          %th.p-2.text-left.border Actions
      %tbody
        - @feedbacks.each do |fb|
          %tr.border-b
            %td.p-2.border.whitespace-nowrap= fb.created_at.strftime('%b %-d, %Y %-I:%M %p')
            %td.p-2.border= fb.display_category
            %td.p-2.border= fb.name.presence || '-'
            %td.p-2.border= fb.email.presence || '-'
            %td.p-2.border= truncate(fb.message, length: 100)
            %td.p-2.border.whitespace-nowrap
              = link_to 'View', admin_feedback_path(fb), class: 'text-blue-600 underline mr-2'
              = button_to 'Delete', admin_feedback_path(fb), method: :delete, data: { turbo_confirm: 'Delete this submission?' }, class: 'text-red-600 underline inline'
