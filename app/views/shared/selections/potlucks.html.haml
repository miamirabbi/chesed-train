- if current_user && !current_user.guest?
  .container.p-10
    .flex.flex-col.bg-primary.items-center.justify-center.border.border-primary.rounded-lg.lg:p-10.p-5.w-full.relative
      %div{ class: "text-secondary lg:text-3xl text-[1rem] font-lato font-[700] mb-5"}
        Volunteer
      = form_with model: selection, url: add_volunteer_potluck_selection_path(event, @selection), method: :patch, class: 'lg:space-y-4 space-y-2 lg:w-1/2 w-full', data: { turbo: false } do |f|
        - if selection.errors.any?
          %div{:style => "color: red"}
            %h2
              = pluralize(selection.errors.count, "error")
              prohibited this selection from being saved:
            %ul
              - selection.errors.each do |error|
                %li= error.full_message
        .area.mb-5
          %div{ class: "text-secondary text-lg font-lato font-semibold"} 
            Menu Item Selected:
          %div{ class: "text-secondary text-lg font-lato font-normal"} 
            = selection.name
          %div.mt-2{ class: "text-secondary text-l font-lato font-semibold"} 
            Volunteer:
          %div{ class: "text-secondary text-lg font-lato font-normal"} 
            = current_user.name
        .area
          %div.mt-2{ class: "text-secondary text-l font-lato font-semibold"} 
            - if event.type == 'ChesedTrain'
              What will you be sending:
            - else
              What will you be bringing:
          = f.text_field :bringing, class: 'w-full lg:px-3 px-2 lg:py-2 py-1 border border-secondary rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-500'
        .mt-10.flex.justify-center.lg:space-x-2.space-y-5.items-center.lg:flex-row.flex-col.cols-1
          = f.submit "Volunteer", class: 'lg:mt-5 w-[11rem] bg-primary-original border border-secondary text-white lg:py-2 py-1 text-center rounded-xl hover:bg-blue-700 transition duration-200 cursor-pointer'
          = link_to "Back", potluck_path(event), class: 'mt-5 w-[11rem] bg-primary-original border border-secondary text-white lg:py-2 py-1 text-center rounded-xl hover:bg-blue-700 transition duration-200 cursor-pointer'
- else
  .container.p-10
    .flex.flex-col.items-center.justify-center.border.border-primary.rounded-lg.lg:p-10.p-5.w-full.relative
      %div{ class: "text-secondary lg:text-[2rem] text-[1rem] font-lato font-[700] mb-5"} 
        Volunteer
      
      .w-full.lg:w-2/3.mb-6
        .flex.flex-col.lg:flex-row.gap-4.justify-center
          = link_to 'Create Account', '#create-account', class: 'flex-1 text-center py-3 px-6 bg-primary-original border border-secondary text-white rounded-xl hover:bg-blue-700 transition duration-200 cursor-pointer', data: { action: 'click', target: 'account-form' }, onclick: "document.getElementById('guest-form').classList.add('hidden'); document.getElementById('account-form').classList.remove('hidden'); return false;"
          = link_to 'Continue as Guest', '#guest', class: 'flex-1 text-center py-3 px-6 bg-white border border-secondary text-secondary rounded-xl hover:bg-gray-100 transition duration-200 cursor-pointer', onclick: "document.getElementById('account-form').classList.add('hidden'); document.getElementById('guest-form').classList.remove('hidden'); return false;"
      
      #account-form.w-full
        %div{ class: "text-secondary text-lg font-lato font-[600] mb-3 text-center"} 
          Create your Account
        = render partial: 'shared/steps/user', locals: { user: User.new, url: setup_volunteer_potluck_selection_path(@event, @selection), method: :post }
      
      #guest-form.w-full.hidden
        %div{ class: "text-secondary text-lg font-lato font-[600] mb-3 text-center"} 
          Continue as Guest
        = form_tag guest_volunteer_potluck_selection_path(@event, @selection), method: :post, class: 'lg:space-y-4 space-y-2 lg:w-1/2 w-full mx-auto', data: { turbo: false } do
          .form-group
            = label_tag :guest_name, "Full Name *", class: 'block text-sm font-bold text-secondary mb-1'
            = text_field_tag :guest_name, nil, class: 'w-full px-3 py-2 border border-secondary rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-500', required: true
          .form-group
            = label_tag :guest_email, "Email *", class: 'block text-sm font-bold text-secondary mb-1'
            = email_field_tag :guest_email, nil, class: 'w-full px-3 py-2 border border-secondary rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-500', required: true
          .form-group
            = label_tag :guest_phone, "Phone Number *", class: 'block text-sm font-bold text-secondary mb-1'
            = telephone_field_tag :guest_phone, nil, class: 'w-full px-3 py-2 border border-secondary rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-500', required: true
          .form-group
            = label_tag :bringing, "What will you be bringing?", class: 'block text-sm font-bold text-secondary mb-1'
            = text_field_tag :bringing, nil, class: 'w-full px-3 py-2 border border-secondary rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-500'
          .mt-6.flex.justify-center
            = submit_tag "Volunteer as Guest", class: 'w-[11rem] bg-primary-original border border-secondary text-white lg:py-2 py-1 text-center rounded-xl hover:bg-blue-700 transition duration-200 cursor-pointer'


