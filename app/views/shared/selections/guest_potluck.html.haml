.container.p-10
  .flex.flex-col.bg-primary.items-center.justify-center.border.border-primary.rounded-lg.lg:p-10.p-5.w-full.relative
    %div{ class: "text-secondary lg:text-3xl text-[1rem] font-lato font-[700] mb-2"}
      Volunteer as a Guest
    %p.text-secondary.text-sm.mb-5.text-center
      No account needed - just share a few details so the organizer can reach you.

    = form_with url: guest_volunteer_potluck_selection_path(event, selection), method: :post, class: 'lg:space-y-4 space-y-2 lg:w-1/2 w-full', data: { turbo: false } do |f|
      .area.mb-3
        %div{ class: "text-secondary text-lg font-lato font-semibold"}
          Menu Item Selected:
        %div{ class: "text-secondary text-lg font-lato font-normal"}
          = selection.name

      .area
        = label_tag :guest_name, "Name", class: 'block text-sm font-bold text-secondary mb-1'
        = text_field_tag :guest_name, nil, class: 'w-full lg:px-3 px-2 lg:py-2 py-1 border border-secondary rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-500', required: true

      .area
        = label_tag :guest_phone, "Phone Number", class: 'block text-sm font-bold text-secondary mb-1'
        = telephone_field_tag :guest_phone, nil, class: 'w-full lg:px-3 px-2 lg:py-2 py-1 border border-secondary rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-500', required: true

      .area
        = label_tag :guest_email, "Email", class: 'block text-sm font-bold text-secondary mb-1'
        = email_field_tag :guest_email, nil, class: 'w-full lg:px-3 px-2 lg:py-2 py-1 border border-secondary rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-500', required: true

      .area
        = label_tag :bringing, "What are you bringing", class: 'block text-sm font-bold text-secondary mb-1'
        = text_field_tag :bringing, nil, class: 'w-full lg:px-3 px-2 lg:py-2 py-1 border border-secondary rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-500'

      .mt-10.flex.justify-center.lg:space-x-2.space-y-5.items-center.lg:flex-row.flex-col.cols-1
        = f.submit "Volunteer", class: 'lg:mt-5 w-[11rem] bg-primary-original border border-secondary text-white lg:py-2 py-1 text-center rounded-xl hover:bg-blue-700 transition duration-200 cursor-pointer', data: { testid: 'guest-volunteer-submit' }
        = link_to "Back", potluck_path(event), class: 'mt-5 w-[11rem] bg-primary-original border border-secondary text-white lg:py-2 py-1 text-center rounded-xl hover:bg-blue-700 transition duration-200 cursor-pointer'
